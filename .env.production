# Production build (`npm run build`, mode "production"). Committed on purpose: everything here ships inside the
# public JS bundle anyway. Vite layers .env → .env.local → .env.production → .env.production.local, so a
# machine-local .env (test project for `npm run dev`) never leaks into the production build.
VITE_ENV=production

# Firebase web app config — project shamyra-web (Firebase Console → Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=AIzaSyCLoDz-OwPfYexTIQ-9qGenygouZUmaTdA
VITE_FIREBASE_AUTH_DOMAIN=shamyra-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shamyra-web
VITE_FIREBASE_STORAGE_BUCKET=shamyra-web.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=909680715029
VITE_FIREBASE_APP_ID=1:909680715029:web:c93a39abb2e917b1a9f51c
VITE_FIREBASE_MEASUREMENT_ID=G-WRPNS5PCPK

# PayPal live client id (public) is read from the untracked .env / .env.production.local on the deploy machine
# as VITE_PAYPAL_CLIENT_ID_LIVE; add it here instead if you prefer it versioned.
# Meta Pixel id (public): set VITE_META_PIXEL_ID here (or in .env.production.local) and redeploy to enable.
