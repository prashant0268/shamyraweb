rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Public catalog; only admins write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store settings: public read (shipping threshold, announcement), admin write.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Discount codes are validated server-side; clients can read a single code to preview it.
    match /discounts/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Orders are created and updated ONLY by Cloud Functions (Admin SDK).
    // Customers can read their own; admins can read all and update fulfilment fields.
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'tracking', 'internalNotes', 'updatedAt']);
    }

    // Reviews: anyone can read approved reviews; signed-in users create; admins moderate.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /newsletter/{email} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Corporate quote requests: created via Cloud Function; admins manage.
    match /quotes/{quoteId} {
      allow read, write: if isAdmin();
    }

    // Outbound mail queue (Trigger Email extension format). Server-only.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Subscriptions are written by Cloud Functions; customers read their own.
    match /subscriptions/{subId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /counters/{doc} {
      allow read, write: if false;
    }

    // Marketing contacts (welcome/care/reorder state, unsubscribe). Written by Cloud Functions; admins read.
    match /marketing/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Server-side config (Resend audience id). Never exposed.
    match /system/{doc} {
      allow read, write: if false;
    }
  }
}
