# TEST project (alias "test"). Overrides functions/.env. Rename this file if the test project gets a different id.
# IS_PRODUCTION=false means: PayPal can never go live from this project, PAYPAL_MODE defaults to sandbox,
# and there are no "production hosts". Use Stripe TEST keys and PayPal SANDBOX credentials in its secrets.
SITE_URL=https://kindflames-test.web.app
IS_PRODUCTION=false
# Add https://test.kindflames.com here once the custom domain is connected (and set SITE_URL to it).
EXTRA_ORIGINS=
# Test emails go to the owner only; use a sender on a verified Resend domain or Resend's onboarding sender.
FROM_EMAIL=Kind Flames (test) <orders@kindflames.com>
