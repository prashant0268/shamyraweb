# Test environment build (`npm run build:test`, mode "test"). Points the bundle at the TEST Firebase project.
# Replace every "REPLACE_ME" with the web app config of the test project once it exists
# (Firebase Console → Project settings → General → Your apps → Config). Project id placeholder: kindflames-test.
# Vite layers .env → .env.local → .env.test → .env.test.local; use .env.test.local for anything you do not want committed.
VITE_ENV=test

VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=kindflames-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kindflames-test
VITE_FIREBASE_STORAGE_BUCKET=kindflames-test.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME
# Leave empty: no Google Analytics stream for the test project (analytics is off outside production anyway).
VITE_FIREBASE_MEASUREMENT_ID=

# PayPal sandbox client id (public) comes from .env / .env.test.local as VITE_PAYPAL_CLIENT_ID.
# Meta Pixel stays off: VITE_META_PIXEL_ID unset.
VITE_META_PIXEL_ID=
