# Copy to `.env` for local development (`npm run dev`). `.env` is git-ignored and is loaded in EVERY mode,
# so keep only local/dev values here; production and test builds override the Firebase block via the committed
# .env.production / .env.test. See docs/ENVIRONMENTS.md.

# Which environment this bundle is. production | test | development.
# Unset: `vite build` = production, `vite dev` = development.
VITE_ENV=development

# Firebase web app config (Firebase Console → Project settings → General → Your apps → Config).
# For local dev point these at the TEST project (kindflames-test) once it exists, never at production.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=kindflames-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kindflames-test
VITE_FIREBASE_STORAGE_BUCKET=kindflames-test.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=

# PayPal (public client ids; the secrets live in Secret Manager, see functions/).
# Sandbox id: used whenever VITE_ENV is not "production" (dev server, test builds).
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
# Live id: used only by production builds.
VITE_PAYPAL_CLIENT_ID_LIVE=your_paypal_live_client_id

# Stripe publishable key is not used by the storefront (Stripe Checkout is a server-created redirect).
# Kept for reference only.
VITE_STRIPE_PUBLIC_KEY=

# Development: set to "true" to route callable functions to the local emulator (localhost:5001)
VITE_USE_EMULATOR=false

# Meta (Facebook) Pixel. Events Manager > Data sources > your pixel > Settings > Pixel ID (15-16 digits).
# Leave empty to disable: nothing is loaded and no fbq calls run. Production value belongs in .env.production.
VITE_META_PIXEL_ID=
